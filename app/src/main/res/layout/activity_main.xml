<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/pageMonitor"
            layout="@layout/page_monitor" />

        <include
            android:id="@+id/pageOptimize"
            layout="@layout/page_optimize"
            android:visibility="gone" />

        <include
            android:id="@+id/pageInsights"
            layout="@layout/page_insights"
            android:visibility="gone" />

        <include
            android:id="@+id/pageKernel"
            layout="@layout/page_kernel"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>